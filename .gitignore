# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Secrets / local config
.env
.env.*
!.env.example

# Data (large / redistributable-restricted). Directory structure kept via .gitkeep
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.parquet
*.feather
*.pkl
*.pickle
*.csv.gz

# pybaseball cache
.pybaseball/
pybaseball_cache/

# Outputs: ignore bulky generated files, keep curated figures if desired
output/*
!output/.gitkeep
!output/figures/
!output/figures/**

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
